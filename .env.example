# Export these variables in your shell. No dotenv auto-loading or stored credentials.
TRACEFORGE_BASE_URL=https://api.openai.com/v1
TRACEFORGE_API_KEY=
TRACEFORGE_MODEL=
TRACEFORGE_API_STYLE=chat
# JSON array; only these roots may be registered. Empty means the bundled fixture only.
TRACEFORGE_ALLOWED_ROOTS=[]
TRACEFORGE_DATA_DIR=.traceforge
TRACEFORGE_API_TOKEN=
TRACEFORGE_MAX_STEPS=10
TRACEFORGE_REQUEST_TIMEOUT=60
TRACEFORGE_MAX_RUN_SECONDS=240
TRACEFORGE_MAX_TOTAL_TOKENS=60000
TRACEFORGE_MAX_OUTPUT_TOKENS=6000
TRACEFORGE_TEST_TIMEOUT=45
TRACEFORGE_DOCKER_IMAGE=python:3.12-slim
